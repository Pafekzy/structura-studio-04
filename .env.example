# Gemini API Key for server-side AI endpoints
GEMINI_API_KEY=

# Authentication Mode: 'sandbox' (developer preview) or 'firebase' (production cryptographically verified)
STRUCTURA_AUTH_MODE=sandbox

# Developer Demo Mode flag for local testing (disabled in production)
VITE_ENABLE_DEVELOPER_DEMO_MODE=true

# Firebase Client Web Configuration (Public)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin Server Configuration (Server Secret)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
